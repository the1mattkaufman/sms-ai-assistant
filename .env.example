# AI Provider Configuration
# Default provider is 'gemini'. Other providers can be registered in src/providers/
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=3000

# Security: Allowed Phone Numbers (Required - Fail-Closed)
# Comma-separated list of E.164 phone numbers permitted to query the assistant.
# If left empty, all incoming SMS requests are rejected.
# Example: +12345678901
ALLOWED_PHONE_NUMBERS=+12345678901

# Twilio Security & Outbound Fallback Configuration
# VALIDATE_TWILIO_SIGNATURE ensures incoming webhook requests genuinely originate from Twilio.
# Set to 'false' ONLY during local curl testing without Twilio.
VALIDATE_TWILIO_SIGNATURE=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10987654321
# Timeout in ms before acknowledging the webhook and delivering the AI reply via Twilio REST API
WEBHOOK_TIMEOUT_MS=12000

# Security: Per-Sender Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Conversation Thread & Session Settings
# Time-to-live for an inactive thread in milliseconds (default: 86400000 = 24 hours)
SESSION_TTL_MS=86400000
# Maximum number of messages (user + assistant) retained in context window (default: 20 = 10 turns)
SESSION_MAX_MESSAGES=20
# Cloud Firestore Persistence (Automatically enabled on Firebase Functions, or set to 'true' on Cloud Run)
USE_FIRESTORE=false
FIRESTORE_COLLECTION=conversations
# Optional file path to persist conversation threads locally when USE_FIRESTORE=false
SESSION_STORAGE_PATH=

# Local Development Only: Enable POST /test JSON endpoint
ENABLE_TEST_ENDPOINT=false

# System Prompt Customization
SYSTEM_INSTRUCTION="You are a personal SMS AI assistant for an offline/in-flight user. Your replies are sent as standard SMS text messages. Be concise, high-signal, and direct. Use plain text only: do not use Markdown (**bold**, ### headings, or ```code``` fences). Prefer short bullet points (-) when listing items."
