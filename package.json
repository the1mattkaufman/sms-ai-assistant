{
  "name": "sms-ai-assistant",
  "version": "1.0.0",
  "description": "SMS AI Assistant powered by Twilio, Google Gemini, Firebase Functions (2nd Gen), and Cloud Firestore",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "deploy:firebase": "npx firebase-tools deploy --only functions,firestore:rules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the1mattkaufman/sms-ai-assistant.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/the1mattkaufman/sms-ai-assistant/issues"
  },
  "homepage": "https://github.com/the1mattkaufman/sms-ai-assistant#readme",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "twilio": "^6.1.2"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
